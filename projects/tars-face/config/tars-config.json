{
    "_comment": "TARS Runtime Configuration — Phase 10.3.1 (updated to match deployed topology)",

    "server": {
        "port": 8080,
        "host": "0.0.0.0"
    },

    "eventBus": {
        "historySize": 1000,
        "heartbeatIntervalMs": 30000,
        "defaultEventTtl": 300
    },

    "monitoring": {
        "healthIntervalMs": 10000,
        "cpuWarningThreshold": 80,
        "memoryWarningThreshold": 85,
        "diskWarningThreshold": 90,
        "tempWarningC": 75
    },

    "monitors": {
        "docker": {
            "enabled": true,
            "socketPath": "/var/run/docker.sock",
            "intervalMs": 15000,
            "timeoutMs": 5000
        },
        "network": {
            "enabled": true,
            "intervalMs": 30000,
            "timeoutMs": 5000,
            "hosts": [
                { "id": "tars", "address": "192.168.0.104" },
                { "id": "alarm-media-pi", "address": "192.168.0.103" },
                { "id": "truenas-optiplex", "address": "192.168.0.100" }
            ]
        }
    },

    "services": {
        "plex": {
            "enabled": true,
            "host": "alarm-media-pi",
            "port": 32400,
            "path": "/web"
        }
    }
}
