{
    "_comment": "TARS Runtime Configuration — Phase 8.1",

    "server": {
        "port": 8080,
        "host": "0.0.0.0"
    },

    "eventBus": {
        "historySize": 1000,
        "heartbeatIntervalMs": 30000,
        "defaultEventTtl": 300
    },

    "monitoring": {
        "healthIntervalMs": 10000,
        "cpuWarningThreshold": 80,
        "memoryWarningThreshold": 85,
        "diskWarningThreshold": 90,
        "tempWarningC": 75
    },

    "monitors": {
        "docker": {
            "enabled": true,
            "socketPath": "/var/run/docker.sock",
            "intervalMs": 15000,
            "timeoutMs": 5000
        },
        "network": {
            "enabled": true,
            "intervalMs": 30000,
            "timeoutMs": 5000,
            "hosts": [
                { "id": "tars", "address": "localhost" },
                { "id": "optiplex", "address": "192.168.1.100" },
                { "id": "truenas", "address": "192.168.1.100" }
            ]
        }
    }
}
